---
import { Languages } from '@lucide/astro';
import { languages, type Lang } from '@/i18n/ui';
import { switchLocalePath } from '@/i18n/utils';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const other: Lang = lang === 'fa' ? 'en' : 'fa';
const href = switchLocalePath(pathname, other);
---

<a
  href={href}
  hreflang={other}
  aria-label={`${languages[other]}`}
  class='text-muted-foreground hover:bg-accent hover:text-foreground inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium transition-colors'
>
  <Languages class='size-4' />
  <span lang={other}>{languages[other]}</span>
</a>
