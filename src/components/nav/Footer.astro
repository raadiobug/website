---
import Logo from '@/components/brand/Logo.astro';
import BrandIcon from '@/components/brand/BrandIcon.astro';
import { socials } from '@/data/socials';
import { useTranslations, localizedPath, formatNumber } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { version } from '../../../package.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = formatNumber(new Date().getFullYear(), lang);
---

<footer class='border-border/60 bg-card/40 mt-24 border-t'>
  <div class='container-page flex flex-col gap-8 py-12'>
    <div class='flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center'>
      <a
        href={localizedPath('/', lang)}
        class='text-foreground'
        aria-label={t('site.name')}
      >
        <Logo
          lang={lang}
          markClass='h-10 w-auto'
        />
      </a>

      <div class='flex flex-col gap-3'>
        <span class='text-muted-foreground text-sm font-medium'>{t('footer.follow')}</span>
        <ul class='flex flex-wrap items-center gap-2'>
          {
            socials.map(s => (
              <li>
                <a
                  href={s.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-label={s.label}
                  title={s.label}
                  class='border-border bg-background text-muted-foreground hover:border-primary hover:text-primary inline-flex size-10 items-center justify-center rounded-full border transition-colors'
                >
                  <BrandIcon name={s.key} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class='border-border/60 text-muted-foreground flex flex-col items-center justify-between gap-2 border-t pt-6 text-sm sm:flex-row'
    >
      <p>{t('footer.tagline')}</p>
      <p class='flex items-center gap-2'>
        <span>© {year} {t('site.name')}. {t('footer.rights')}</span>
        <a
          href='https://github.com/raadiobug/website/releases'
          target='_blank'
          rel='noopener noreferrer'
          class='hover:text-foreground font-mono text-xs opacity-70 transition-colors'
          dir='ltr'
        >
          v{version}
        </a>
      </p>
    </div>
  </div>
</footer>
