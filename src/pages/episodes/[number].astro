---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EpisodeDetailView from '@/components/views/EpisodeDetailView.astro';
import { getEpisodes, episodeTitle, episodeDescription } from '@/lib/episodes';

export const getStaticPaths = (async () => {
  const episodes = await getEpisodes();
  return episodes.map(episode => ({
    params: { number: String(episode.data.number) },
    props: { episode }
  }));
}) satisfies GetStaticPaths;

const { episode } = Astro.props;
---

<BaseLayout
  lang='fa'
  title={episodeTitle(episode, 'fa')}
  description={episodeDescription(episode, 'fa')}
  ogType='article'
>
  <EpisodeDetailView
    lang='fa'
    episode={episode}
  />
</BaseLayout>
