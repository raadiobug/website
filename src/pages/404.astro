---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { House } from '@lucide/astro';
import { useTranslations, localizedPath } from '@/i18n/utils';

const t = useTranslations('fa');
---

<BaseLayout
  lang='fa'
  title={t('notFound.title')}
>
  <section
    class='container-page flex min-h-[60vh] flex-col items-center justify-center gap-6 py-20 text-center'
  >
    <p class='text-primary text-7xl font-extrabold'>404</p>
    <div class='flex flex-col gap-2'>
      <h1 class='text-2xl font-bold tracking-tight'>{t('notFound.title')}</h1>
      <p class='text-muted-foreground'>{t('notFound.body')}</p>
    </div>
    <a
      href={localizedPath('/', 'fa')}
      class='bg-primary text-primary-foreground inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90'
    >
      <House class='size-4' />
      {t('notFound.home')}
    </a>
  </section>
</BaseLayout>
